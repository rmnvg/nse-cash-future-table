# Postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://cashfuture:cashfuture@localhost:5432/cashfuture

# Absolute path to the folder holding the 4 NSE CSV files.
# NOT committed to the repo — these files are hundreds of MB.
DATA_DIR=/absolute/path/to/folder/with/csv/files

# File names within DATA_DIR
CM_CONTRACT_FILE=nse_cm_ref_contract_master.csv
FO_CONTRACT_FILE=nse_fo_ref_contract_master.csv
CM_MARKET_DATA_FILE=nsecm_market_data.csv
FO_MARKET_DATA_FILE=nsefo_market_data.csv

# NSE contract expiryDate and market data timestamp fields are stored as
# seconds since 1980-01-01 00:00:00 IST, not the standard Unix epoch.
# Adding this offset converts them to normal Unix seconds (UTC).
NSE_EPOCH_OFFSET_SEC=315513000

# How often (ms) the market data simulator advances to the next tick bucket
TICK_INTERVAL_MS=1000

# Port for the backend HTTP/WebSocket server
PORT=8080

# NSE ships non-tradable test instruments (…NSETEST) in the contract files.
# They have contracts on both legs — so they pass the cash+future join — but
# never receive market data, leaving 18 permanently empty rows at the top of
# the table. Set to false to include them (universe becomes 228 instead of 210).
EXCLUDE_TEST_SYMBOLS=true
